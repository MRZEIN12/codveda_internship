# Copy to .env for local development (Render uses dashboard env vars)

PORT=5000
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Local MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=coveda_internship

# On Render: leave DB_* empty and set DATABASE_URL from Render Postgres
# DATABASE_URL=postgresql://user:pass@host/db
